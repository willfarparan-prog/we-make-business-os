# The We+Make dashboard. Copy to .env.local for local work against a real database,
# or use the PGlite sandbox instead (see README). Never commit real values.

# Database (Neon project "we-make-business")
DATABASE_URL=

# Sign-in (Neon Auth for that project) and the one owner account
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
WM_OWNER_EMAIL=willfarparan@gmail.com
NEXT_PUBLIC_APP_URL=https://we-make-business-dashboard.vercel.app

# The storefront
WM_SITE_URL=https://we-make.vercel.app
# Extra browser origins allowed to call the public endpoints, comma separated
WM_SITE_ORIGINS=

# Stripe: the NEW We+Make account, test mode (sk_test_…). WM_STRIPE_LIVE=1 only when taking real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WM_STRIPE_LIVE=

# Resend (newsletter). Sending also needs Settings → Email set to Test or Live.
RESEND_API_KEY=
RESEND_FROM_EMAIL=We+Make <onboarding@resend.dev>
WM_REPLY_TO=hello@wemake.studio

# Claude assistant
ANTHROPIC_API_KEY=
WM_ASSISTANT_MODEL=claude-sonnet-5

# Local only
WM_LOCAL_DB=
WM_DEV_PREVIEW=
