{
  "name": "we-make-business-os",
  "private": true,
  "description": "We+Make: the business dashboard and the storefront in one repo.",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:dashboard": "pnpm --filter @wm/dashboard dev --port 3100",
    "dev:site": "pnpm --filter @wm/site dev --port 3200",
    "lint": "pnpm --filter @wm/dashboard lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @wm/dashboard test",
    "build": "pnpm --filter @wm/dashboard --filter @wm/site build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
